# Copy to .env and adjust before running docker compose.

# Port the frontend nginx listens on (default 80)
PORT=80

# Number of uvicorn worker processes in the backend container (default 2).
# Rule of thumb: 2 × CPU cores + 1, capped at 4 for I/O-bound workloads.
WEB_CONCURRENCY=2

# Leave empty to use nginx's internal proxy (recommended).
# Set to an absolute URL only when the backend is hosted separately.
# VITE_API_BASE=https://api.example.com
VITE_API_BASE=
