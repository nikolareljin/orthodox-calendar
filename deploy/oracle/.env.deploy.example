# Copy to .env.deploy and fill in values to run manual-deploy.sh locally.
# This file is safe to commit. .env.deploy is gitignored.

# SSH username on the Oracle VM (same as OCI_USER GitHub secret)
OCI_USER=ubuntu

# Oracle VM public IP or hostname (same as OCI_HOST GitHub secret)
OCI_HOST=

# Path to the SSH private key file on your local machine
# (contains the same key as OCI_SSH_KEY GitHub secret)
OCI_SSH_KEY_FILE=~/.ssh/deploy_key

# Known-hosts entry for the Oracle VM — used for host key verification.
# A known-hosts line contains spaces, so the value MUST be quoted.
# IMPORTANT: scan the exact same value as OCI_HOST (IP or hostname). Using the
# IP when OCI_HOST is a hostname (or vice-versa) produces a hashed entry that
# StrictHostKeyChecking=yes will not match, causing SSH/SCP to fail.
#   echo "OCI_KNOWN_HOSTS=\"$(ssh-keyscan -t ed25519 -H <VALUE_OF_OCI_HOST>)\""
# (same value as OCI_KNOWN_HOSTS GitHub secret)
OCI_KNOWN_HOSTS=""

# Email for Let's Encrypt expiry notifications (required for TLS provisioning).
# Forwarded to deploy.sh and passed to oc-certbot-provision.
# Required when deploy.sh detects the VM public IP and provisions the HTTPS API.
CERTBOT_EMAIL=

# Public API base URL (same as VITE_API_BASE GitHub secret).
# When set, manual-deploy.sh polls this/health after deploy.sh completes,
# mirroring the CI backend-deploy health check. Leave empty to skip.
VITE_API_BASE=
